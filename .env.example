# =============================================================================
# Physics by Senath - Environment Variables Configuration Template
# =============================================================================

# Server Port Configuration (Dynamic / Custom Port for Shared Servers)
# - Set PORT or SERVER_PORT to any custom uncommon port number or passenger socket
# - Defaults to uncommon port 48293 (or binds dynamically to any free port if occupied)
PORT=48293
# SERVER_PORT=48293
# VITE_PORT=48294

# MySQL Database Configuration
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=physicsbysenath

# Google OAuth 2.0 Web Client ID (Frontend & Backend Token Verification)
# DO NOT put client secrets here!
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Server-Side Google OAuth Client Secret (Backend only)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# Cloudflare R2 Storage Configuration (Server-Side Only)
# DO NOT use VITE_ prefixes. Never expose these to the browser frontend!
# =============================================================================
R2_ACCOUNT_ID=840614462b8d699d75ff7f564d9f6b1e
R2_BUCKET_NAME=physicsbysenath-lab
R2_ENDPOINT=https://840614462b8d699d75ff7f564d9f6b1e.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
