# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Required for Google Identity Services (GIS) Web Authentication.
# NOTE: Never put any OAuth Client Secret in this file or the frontend!
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
